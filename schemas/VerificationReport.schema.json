{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationReport",
  "description": "Independent acceptance evidence. The oracle lives outside the generated Actor and outside the public portal.",
  "type": "object",
  "required": [
    "cases",
    "oracle_ref",
    "passed",
    "tested_environment",
    "verified_at"
  ],
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CaseResult"
      }
    },
    "tested_environment": {
      "description": "What environment was tested, e.g. `\"fixture-portal v1, Apify LIMITED_PERMISSIONS\"`.",
      "type": "string"
    },
    "limitations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "oracle_ref": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "CaseResult": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "passed"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/CaseKind"
        },
        "passed": {
          "type": "boolean"
        },
        "detail": {
          "default": "",
          "type": "string"
        }
      }
    },
    "CaseKind": {
      "oneOf": [
        {
          "description": "A fixture variant where extraction must succeed and match the oracle.",
          "type": "string",
          "enum": [
            "success"
          ]
        },
        {
          "description": "A fixture where data is missing or unsupported and the Actor must say so.",
          "type": "string",
          "enum": [
            "unsupported"
          ]
        }
      ]
    }
  }
}
