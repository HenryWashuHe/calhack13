  "required": [
    "event_id",
    "org_id",
    "revision",
    "schema_version",
    "seq",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "seq": {
      "description": "Durable sequence assigned by the store. Used as the SSE cursor.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "event_id": {
      "type": "string"
    },
    "org_id": {
      "type": "string"
    },
    "mission_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "description": "Event or request that caused this event.",
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "description": "Organization revision after this event was applied.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "ChangeStatus": {
      "description": "Organization-change lifecycle (TECH_SPEC §5).",
      "type": "string",
      "enum": [
        "PROPOSED",
        "VALIDATED",
        "PROVISIONING",
        "READY",
        "COMMITTED",
        "REJECTED",
        "FAILED"
      ]
    },
    "Provider": {
      "description": "Who implements a role or runs a job.",
      "oneOf": [
        {
          "description": "Elastic Agent Builder on Serverless: internal specialists.",
          "type": "string",
          "enum": [
            "elastic"
          ]
        },
        {
          "description": "Fetch.ai uAgents: independent external specialists.",
          "type": "string",
          "enum": [
            "fetch"
          ]
        },
        {
          "description": "CREAO: persistent operational roles.",
          "type": "string",
          "enum": [
            "creao"
          ]
        },
        {
          "description": "Apify: executable capabilities (Actors). Never an employee.",
          "type": "string",
          "enum": [
            "apify"
          ]
        },
        {
          "description": "Implemented by the kernel itself (e.g. the mission controller).",
          "type": "string",
          "enum": [
            "internal"
          ]
        },
        {
          "description": "Development-only stand-in. The UI must label it as not a live integration.",
          "type": "string",
          "enum": [
            "dev_stub"
          ]
        }
      ]
    },
    "Executor": {
      "description": "Who currently executes a responsibility. Delegation changes the executor, never the accountable owner.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "role"
              ]
            },
            "id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "contractor"
              ]
            },
            "id": {
              "type": "string"
            }
          }
        }
      ]
    },
    "ContractState": {
      "description": "External contractor agreement (Fetch specialist).",
      "type": "string",
      "enum": [
        "REQUESTED",
        "OFFERED",
        "ACCEPTED",
        "RELEASED",
        "DECLINED"
      ]
    },
    "CapabilityRef": {
      "description": "Exact reference to an approved capability version. There is no `latest`.",
      "type": "object",
      "required": [
        "capability_id",
        "version"
      ],
      "properties": {
        "capability_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "JobStatus": {
      "description": "Normalized job status (TECH_SPEC §6). Provider-native statuses are kept separately on the job record.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "QUEUED",
            "SUBMITTING",
            "RUNNING",
            "VERIFYING",
            "SUCCEEDED",
            "FAILED",
            "RESULT_REJECTED"
          ]
        },
        {
          "description": "The outcome is not known (e.g. a dropped stream). Never treated as success.",
          "type": "string",
          "enum": [
            "UNKNOWN"
          ]
        }
      ]
    }
  }
}
