# Copy to .env (git-ignored). Never commit real keys.

# Planner model: pending until the team picks one.
# GENESIS_LLM_PROVIDER = anthropic | openai | gemini | openai-compatible | elastic | pending
# elastic uses the Agent Builder settings below and ignores MODEL/API_KEY.
GENESIS_LLM_PROVIDER=pending
GENESIS_LLM_MODEL=
GENESIS_LLM_API_KEY=
# Only for openai-compatible, or to override the default endpoint.
GENESIS_LLM_BASE_URL=

# Which organization the planner watches, and its agent (not operator) token.
GENESIS_ORG_URL=http://127.0.0.1:7101
GENESIS_AGENT_TOKEN=org_a-agent

# Elastic (optional). Data: projection, evidence and capability search.
ELASTICSEARCH_URL=
ELASTIC_DATA_API_KEY=
# Agent Builder: specialists and the elastic planner.
ELASTIC_KIBANA_URL=
ELASTIC_MANAGEMENT_API_KEY=
# ELASTIC_KIBANA_SPACE=
# GENESIS_ELASTIC_INDEX_PREFIX=genesis

# Live sponsor validation (docs/LIVE_GATES.md). Uncomment and fill locally.
# Apify builds/runs and CREAO API Trigger runs spend provider credits.
# APIFY_TOKEN=
# CREAO uses a published app's API Trigger credits; Developer v1/v2 is disabled
# in the server, backend CLI and live gate. Never substitute a cr_sk_ key.
# CREAO_API_VERSION=trigger
# CREAO_TRIGGER_API_KEY=
# CREAO_TRIGGER_APP_ID=
# Optional; must match https://agent.creao.ai/api/v1/apps/<app-id>/runs exactly.
# CREAO_TRIGGER_RUNS_URL=
# To enable the server specialist, set all three too. Create private parents.
# Use NEW Trigger journals; do not reuse Developer API operation databases.
# GENESIS_CREAO_DB=data/creao-trigger/org-a.sqlite
# GENESIS_CREAO_ACCOUNT=creao-trigger-team
# GENESIS_CREAO_QUOTA_DB=data/creao-trigger/team-quota.sqlite
# For readiness, each org also needs its own reachable GENESIS_PUBLIC_URL.
# GENESIS_PUBLIC_URL=https://org-a.example.com
# AGENTVERSE_API_KEY=

# Optional Fetch venue recovery (docs/VENUE_RECOVERY.md).
# Supply all five together; use the bridge/specialist's actual public identities.
# GENESIS_FETCH_BRIDGE_URL=http://127.0.0.1:8101/v1
# GENESIS_FETCH_BRIDGE_TOKEN=
# GENESIS_FETCH_BRIDGE_ADDRESS=
# GENESIS_FETCH_SPECIALIST_ADDRESS=
# GENESIS_FETCH_RUNTIME_DB=.local/org-a-fetch-runtime.sqlite
# Explicit opt-in to automatic recruitment after an accepted venue Reopen.
# Applies to fresh historical decisions too; see docs/VENUE_RECOVERY_INTAKE.md.
# GENESIS_AUTOMATIC_VENUE_RECOVERY=false

# Optional public ACP demo gateway (separate identity; see docs/FETCH_SPONSOR_NOTES.md).
# GENESIS_ACP_SEED=
# GENESIS_ACP_BACKEND_URL=http://127.0.0.1:4100/api/v1
# GENESIS_ACP_OPERATOR_TOKEN=

# ASI:One primary workflow agent (separate identity; report evidence and watch the
# organization evolve from a chat). Holds the org *agent* token, never the operator token.
# GENESIS_ACP_MISSION_SEED=
# GENESIS_ACP_BACKEND_URL=http://127.0.0.1:7101/api/v1
# GENESIS_ACP_AGENT_TOKEN=org_a-agent
