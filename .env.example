# Copy to .env (git-ignored). Never commit real keys.

# Planner model: pending until the team picks one.
# GENESIS_LLM_PROVIDER = anthropic | openai | gemini | openai-compatible | elastic | pending
# elastic uses the Agent Builder settings below and ignores MODEL/API_KEY.
GENESIS_LLM_PROVIDER=pending
GENESIS_LLM_MODEL=
GENESIS_LLM_API_KEY=
# Only for openai-compatible, or to override the default endpoint.
GENESIS_LLM_BASE_URL=

# Which organization the planner watches, and its agent (not operator) token.
GENESIS_ORG_URL=http://127.0.0.1:7101
GENESIS_AGENT_TOKEN=org_a-agent

# Elastic (optional). Data: projection, evidence and capability search.
ELASTICSEARCH_URL=
ELASTIC_DATA_API_KEY=
# Agent Builder: specialists and the elastic planner.
ELASTIC_KIBANA_URL=
ELASTIC_MANAGEMENT_API_KEY=
# ELASTIC_KIBANA_SPACE=
# GENESIS_ELASTIC_INDEX_PREFIX=genesis
