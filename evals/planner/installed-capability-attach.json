{
  "id": "installed-capability-attach",
  "description": "The capability the owner needs is already installed and approved (the planner's pass after a gap installs). Attach it to the owner; don't request it again.",
  "tags": [
    "change",
    "capability",
    "demo"
  ],
  "mission": {
    "goal": "Run the campus hack night for 120 attendees on Nov 14",
    "constraints": [
      "Budget $5,000",
      "Venue within 2 miles of campus",
      "Doors open 6 pm"
    ],
    "success_checks": [
      "Venue for 120 reserved in the ledger",
      "Attendees notified 48 h before"
    ],
    "roles": [
      {
        "key": "coordinator",
        "name": "Mission coordinator",
        "charter": "Owns the event plan and budget",
        "authority": {
          "scopes": [
            "mission.coordinate"
          ],
          "budget_cents": 150000
        }
      },
      {
        "key": "program",
        "name": "Program lead",
        "charter": "Owns the talk and workshop schedule",
        "authority": {
          "scopes": [
            "program.schedule"
          ],
          "budget_cents": 50000
        },
        "reports_to": "coordinator"
      },
      {
        "key": "info",
        "name": "Attendee information",
        "charter": "Keeps attendees informed",
        "authority": {
          "scopes": [
            "attendees.inform"
          ],
          "budget_cents": 10000
        },
        "reports_to": "coordinator"
      },
      {
        "key": "venue",
        "name": "Venue operations",
        "charter": "Owns venue booking and venue logistics for the event",
        "authority": {
          "scopes": [
            "ledger.reserve_venue",
            "contract.logistics",
            "capability.venue_lookup"
          ],
          "budget_cents": 180000
        },
        "reports_to": "coordinator"
      }
    ],
    "responsibilities": [
      {
        "purpose": "Coordinate the event plan",
        "owner": "coordinator",
        "trigger": "mission events",
        "termination": "event ends"
      },
      {
        "purpose": "Maintain the program schedule",
        "owner": "program",
        "trigger": "schedule changes",
        "termination": "event ends"
      },
      {
        "purpose": "Notify attendees of changes",
        "owner": "info",
        "trigger": "plan changes",
        "termination": "event ends"
      },
      {
        "purpose": "Keep a venue for 120 booked",
        "owner": "venue",
        "trigger": "venue availability changes",
        "termination": "event held"
      }
    ]
  },
  "installed": [
    {
      "capability_id": "venue-portal-reader",
