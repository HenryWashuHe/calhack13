{
  "id": "venue-closure",
  "description": "Demo beat 1. The venue is gone; continuing relocation work needs exactly one accountable owner, at most one new role, no second coordinator.",
  "tags": [
    "change",
    "demo"
  ],
  "mission": {
    "goal": "Run the campus hack night for 120 attendees on Nov 14",
    "constraints": [
      "Budget $5,000",
      "Venue within 2 miles of campus",
      "Doors open 6 pm"
    ],
    "success_checks": [
      "Venue for 120 reserved in the ledger",
      "Attendees notified 48 h before"
    ],
    "roles": [
      {
        "key": "coordinator",
        "name": "Mission coordinator",
        "charter": "Owns the event plan and budget",
        "authority": {
          "scopes": [
            "mission.coordinate"
          ],
          "budget_cents": 150000
        }
      },
      {
        "key": "program",
        "name": "Program lead",
        "charter": "Owns the talk and workshop schedule",
        "authority": {
          "scopes": [
            "program.schedule"
          ],
          "budget_cents": 50000
        },
        "reports_to": "coordinator"
      },
      {
        "key": "info",
        "name": "Attendee information",
        "charter": "Keeps attendees informed",
        "authority": {
          "scopes": [
            "attendees.inform"
          ],
          "budget_cents": 10000
        },
        "reports_to": "coordinator"
      }
    ],
    "responsibilities": [
      {
        "purpose": "Coordinate the event plan",
        "owner": "coordinator",
        "trigger": "mission events",
        "termination": "event ends"
      },
      {
        "purpose": "Maintain the program schedule",
        "owner": "program",
        "trigger": "schedule changes",
        "termination": "event ends"
      },
      {
        "purpose": "Notify attendees of changes",
        "owner": "info",
        "trigger": "plan changes",
        "termination": "event ends"
      }
    ]
  },
  "observation": {
    "source": "portal",
    "summary": "Main hall closed for maintenance on Nov 14",
    "evidence_ref": "https://portal.example/baseline/venues/main-hall.html"
  },
  "expect": {
    "verdicts": [
      "change"
    ],
    "require_any_op": [
      "CreateRole",
      "AssignResponsibility",
      "RecruitSpecialist"
    ],
    "max_new_roles": 1,
    "max_new_budget_cents": 300000,
    "forbid_scopes": [
      "mission.coordinate"
    ],
    "max_attempts": 2
  }
}
